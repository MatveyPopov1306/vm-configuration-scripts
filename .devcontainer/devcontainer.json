{
  "name": "Ubuntu 24.04 Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "remoteUser": "root",
  
  // Дополнительные утилиты, которые подтянутся внутрь контейнера
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.bash-debug",
        "timonwong.shellcheck",
        "mads-hartmann.bash-ide-vscode",
        "rogalmic.bash-debug"
      ]
    }
  },

  // Автоматический запуск терминала сразу внутри контейнера
  // "postCreateCommand": "echo 'Контейнер с Ubuntu 24.04 успешно запущен!'"
  "postCreateCommand": "sudo apt-get update && sudo apt-get install openssh-server -y"
}