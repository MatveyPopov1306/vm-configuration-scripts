{
  "name": "Ubuntu 24.04 Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  
  // Дополнительные утилиты, которые подтянутся внутрь контейнера
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.bash-debug",
        "timonwong.shellcheck"
      ]
    }
  },

  // Автоматический запуск терминала сразу внутри контейнера
  "postCreateCommand": "echo 'Контейнер с Ubuntu 24.04 успешно запущен!'"
}